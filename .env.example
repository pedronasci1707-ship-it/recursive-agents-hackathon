# Copy this file to .env and paste your Crusoe Intelligence API key.
# Keep the SINGLE quotes: Crusoe keys can contain "$", which would be mangled otherwise.
CRUSOE_API_KEY='paste-your-key-here'

# Optional: override the model used for each agent role (exact, case-sensitive IDs from /v1/models)
# MODEL_PLANNER=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
# MODEL_WORKER=nvidia/Nemotron-3.5-Lightning-30B-A3B
# MODEL_FAST=deepseek-ai/Deepseek-V4-Flash
# MODEL_TOOLS=openai/gpt-oss-120b
